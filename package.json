{
  "name": "cookie-share",
  "private": true,
  "version": "0.3.1",
  "description": "Cookie-share Cloudflare Worker deployment tooling",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "check": "wrangler deploy --dry-run",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply COOKIE_DB --remote",
    "test:security": "node --test test-node/*.test.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "wrangler": "^4.75.0",
    "@cloudflare/vitest-plugin": "^1.0.0"
  }
}
